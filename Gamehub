    <!-- МЕГА СДВГ ОВЕРЛЕЙ ПОБЕДЫ В МАДЖОНГЕ -->
    <div id="mj-victory-overlay">
        <div class="victory-rays"></div>
        <div class="victory-card">
            <div class="victory-trophy">🏆</div>
            <div class="victory-title">УРОВЕНЬ ПРОЙДЕН!</div>
            <div class="victory-sub" id="victory-sub">Уровень 1: Старт</div>
            <div class="victory-stars">
                <span class="v-star">⭐</span>
                <span class="v-star">⭐</span>
                <span class="v-star">⭐</span>
            </div>
            <div class="victory-aura" id="victory-aura">🔥 +1000 AURA • MEGA CLEAR!</div>
            <div class="victory-actions">
                <button class="btn btn-green" id="victory-next-btn" onclick="goNextMahjongLevel()">⚡ СЛЕДУЮЩИЙ УРОВЕНЬ</button>
                <button class="btn btn-sm" onclick="closeVictoryAndOpenLevels()">📋 К СПИСКУ УРОВНЕЙ</button>
            </div>
        </div>
    </div>

    <script>
        // ==================== ДВИЖОК СДВГ-АНИМАЦИЙ И ЖИВОГО ФОНА ====================
        const bgCanvas = document.getElementById('bg-canvas');
        const bgCtx = bgCanvas.getContext('2d');
        const fxCanvas = document.getElementById('fx-canvas');
        const fxCtx = fxCanvas.getContext('2d');

        let particles = [];
        let floatTexts = [];
        let bgOrbs = [];
        let bgStars = [];
        let gridOffset = 0;
        let victoryFxTimer = null;

        function resizeCanvases() {
            bgCanvas.width = fxCanvas.width = window.innerWidth;
            bgCanvas.height = fxCanvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvases);
        resizeCanvases();

        for (let i = 0; i < 18; i++) {
            bgOrbs.push({
                x: Math.random() * window.innerWidth,
                y: Math.random() * window.innerHeight,
                r: 18 + Math.random() * 45,
                vx: (Math.random() - 0.5) * 1.4,
                vy: (Math.random() - 0.5) * 1.4,
                hue: Math.random() * 360
            });
        }
        for (let i = 0; i < 70; i++) {
            bgStars.push({
                x: (Math.random() - 0.5) * window.innerWidth,
                y: (Math.random() - 0.5) * window.innerHeight,
                z: Math.random() * 800 + 100
            });
        }

        function getAdhdMode() {
            return document.getElementById('adhd-level').value;
        }

        function spawnBurst(x, y, count = 16, colors = null, power = 1) {
            if (getAdhdMode() === 'off') return;
            const palette = colors || ['#38bdf8', '#f472b6', '#fbbf24', '#4ade80', '#a855f7', '#ffffff'];
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = (2 + Math.random() * 6.5) * power;
                particles.push({
                    x, y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed - 1.5 * power,
                    size: (3 + Math.random() * 5.5) * Math.min(power, 1.4),
                    color: palette[Math.floor(Math.random() * palette.length)],
                    alpha: 1,
                    decay: 0.016 + Math.random() * 0.02,
                    shape: Math.random() > 0.35 ? 'square' : 'circle',
                    rot: Math.random() * Math.PI
                });
            }
        }

        function spawnConfettiCannon(fromLeft) {
            if (getAdhdMode() === 'off') return;
            const x = fromLeft ? 10 : window.innerWidth - 10;
            const y = window.innerHeight - 20;
            const palette = ['#fbbf24', '#4ade80', '#38bdf8', '#f472b6', '#a855f7', '#ffffff', '#fb7185'];
            for (let i = 0; i < 34; i++) {
                const spread = fromLeft
                    ? (-Math.PI / 2.2) + (Math.random() - 0.3) * 0.75
                    : (-Math.PI / 1.8) - (Math.random() - 0.3) * 0.75;
                const speed = 9 + Math.random() * 9;
                particles.push({
                    x, y,
                    vx: Math.cos(spread) * speed,
                    vy: Math.sin(spread) * speed,
                    size: 5 + Math.random() * 7,
                    color: palette[Math.floor(Math.random() * palette.length)],
                    alpha: 1,
                    decay: 0.011 + Math.random() * 0.012,
                    shape: 'square',
                    rot: Math.random() * Math.PI
                });
            }
        }

        function spawnFloatText(x, y, text, color = '#fbbf24') {
            if (getAdhdMode() === 'off') return;
            floatTexts.push({ x, y, text, color, alpha: 1, vy: -2.1 });
        }

        function triggerShake(big = false) {
            if (getAdhdMode() !== 'max') return;
            const cls = big ? 'shake-lg' : 'shake-sm';
            document.body.classList.remove('shake-sm', 'shake-lg');
            void document.body.offsetWidth;
            document.body.classList.add(cls);
        }

        window.addEventListener('pointerdown', (e) => {
            spawnBurst(e.clientX, e.clientY, 10);
        });

        function renderLoop() {
            bgCtx.clearRect(0, 0, bgCanvas.width, bgCanvas.height);
            const bgEffect = document.getElementById('bg-effect-select').value;
            const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();

            if (bgEffect === 'orbs') {
                bgOrbs.forEach(o => {
                    o.x += o.vx; o.y += o.vy; o.hue = (o.hue + 0.4) % 360;
                    if (o.x < -60) o.x = bgCanvas.width + 60;
                    if (o.x > bgCanvas.width + 60) o.x = -60;
                    if (o.y < -60) o.y = bgCanvas.height + 60;
                    if (o.y > bgCanvas.height + 60) o.y = -60;

                    const grad = bgCtx.createRadialGradient(o.x, o.y, 2, o.x, o.y, o.r);
                    grad.addColorStop(0, `hsla(${o.hue}, 90%, 65%, 0.28)`);
                    grad.addColorStop(1, 'transparent');
                    bgCtx.fillStyle = grad;
                    bgCtx.beginPath(); bgCtx.arc(o.x, o.y, o.r, 0, Math.PI * 2); bgCtx.fill();
                });
            } else if (bgEffect === 'stars') {
                const cx = bgCanvas.width / 2, cy = bgCanvas.height / 2;
                bgCtx.fillStyle = accent || '#38bdf8';
                bgStars.forEach(s => {
                    s.z -= 4;
                    if (s.z <= 10) {
                        s.x = (Math.random() - 0.5) * bgCanvas.width;
                        s.y = (Math.random() - 0.5) * bgCanvas.height;
                        s.z = 800;
                    }
                    const k = 250 / s.z;
                    const px = cx + s.x * k, py = cy + s.y * k;
                    const sz = Math.max(1, (1 - s.z / 800) * 4);
                    bgCtx.globalAlpha = 1 - s.z / 800;
                    bgCtx.fillRect(px, py, sz, sz);
                });
                bgCtx.globalAlpha = 1;
            } else if (bgEffect === 'grid') {
                gridOffset = (gridOffset + 0.8) % 40;
                bgCtx.strokeStyle = accent || '#38bdf8';
                bgCtx.globalAlpha = 0.14;
                bgCtx.lineWidth = 1;
                for (let x = 0; x < bgCanvas.width; x += 40) {
                    bgCtx.beginPath(); bgCtx.moveTo(x, 0); bgCtx.lineTo(x, bgCanvas.height); bgCtx.stroke();
                }
                for (let y = gridOffset; y < bgCanvas.height; y += 40) {
                    bgCtx.beginPath(); bgCtx.moveTo(0, y); bgCtx.lineTo(bgCanvas.width, y); bgCtx.stroke();
                }
                bgCtx.globalAlpha = 1;
            }

            fxCtx.clearRect(0, 0, fxCanvas.width, fxCanvas.height);
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx; p.y += p.vy; p.vy += 0.2;
                p.alpha -= p.decay; p.rot += 0.14;
                if (p.alpha <= 0) { particles.splice(i, 1); continue; }

                fxCtx.save();
                fxCtx.globalAlpha = p.alpha;
                fxCtx.fillStyle = p.color;
                fxCtx.translate(p.x, p.y);
                fxCtx.rotate(p.rot);
                if (p.shape === 'circle') {
                    fxCtx.beginPath(); fxCtx.arc(0, 0, p.size / 2, 0, Math.PI * 2); fxCtx.fill();
                } else {
                    fxCtx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.7);
                }
                fxCtx.restore();
            }

            for (let i = floatTexts.length - 1; i >= 0; i--) {
                const ft = floatTexts[i];
                ft.y += ft.vy; ft.alpha -= 0.02;
                if (ft.alpha <= 0) { floatTexts.splice(i, 1); continue; }
                fxCtx.save();
                fxCtx.globalAlpha = ft.alpha;
                fxCtx.font = '900 22px Segoe UI, sans-serif';
                fxCtx.textAlign = 'center';
                fxCtx.fillStyle = ft.color;
                fxCtx.shadowColor = ft.color;
                fxCtx.shadowBlur = 12;
                fxCtx.fillText(ft.text, ft.x, ft.y);
                fxCtx.restore();
            }

            requestAnimationFrame(renderLoop);
        }
        requestAnimationFrame(renderLoop);

        // ==================== КАСТОМИЗАЦИЯ ЛОББИ ====================
        function applyPreset(bg, accent) {
            document.getElementById('bg-picker').value = bg;
            document.getElementById('accent-picker').value = accent;
            updateLobbyColors();
            spawnBurst(window.innerWidth / 2, window.innerHeight / 2, 28, [accent, '#ffffff', '#fbbf24']);
            doVibrate(30);
        }

        function updateLobbyColors() {
            const bg = document.getElementById('bg-picker').value;
            const accent = document.getElementById('accent-picker').value;
            document.documentElement.style.setProperty('--bg', bg);
            document.documentElement.style.setProperty('--accent', accent);
            saveLobbyPrefs();
        }

        function saveLobbyPrefs() {
            try {
                const prefs = {
                    bg: document.getElementById('bg-picker').value,
                    accent: document.getElementById('accent-picker').value,
                    bgEffect: document.getElementById('bg-effect-select').value,
                    adhd: document.getElementById('adhd-level').value
                };
                localStorage.setItem('gameHubLobby', JSON.stringify(prefs));
            } catch {}
        }

        function loadLobbyPrefs() {
            try {
                const saved = JSON.parse(localStorage.getItem('gameHubLobby') || 'null');
                if (!saved) return;
                document.getElementById('bg-picker').value = saved.bg || '#0f172a';
                document.getElementById('accent-picker').value = saved.accent || '#38bdf8';
                document.getElementById('bg-effect-select').value = saved.bgEffect || 'orbs';
                document.getElementById('adhd-level').value = saved.adhd || 'max';
                document.documentElement.style.setProperty('--bg', saved.bg || '#0f172a');
                document.documentElement.style.setProperty('--accent', saved.accent || '#38bdf8');
            } catch {}
        }
        loadLobbyPrefs();

        // ==================== НАВИГАЦИЯ ====================
        function stopAllGames() {
            if (tInt) { clearInterval(tInt); tInt = null; }
            if (victoryFxTimer) { clearInterval(victoryFxTimer); victoryFxTimer = null; }
            document.getElementById('mj-victory-overlay').classList.remove('active');
            mGameOver = true;
            if (mPressTimer) { clearTimeout(mPressTimer); mPressTimer = null; }
        }

        function showScreen(id) {
            stopAllGames();
            document.getElementById('main-menu').style.display = 'none';
            document.querySelectorAll('.screen').forEach(s => s.style.display = 'none');
            document.getElementById(id).style.display = 'flex';
        }

        function backToMenu() {
            stopAllGames();
            document.querySelectorAll('.screen').forEach(s => s.style.display = 'none');
            document.getElementById('main-menu').style.display = 'flex';
        }

        function doVibrate(ms) {
            if (document.getElementById('vibrate-on').checked && navigator.vibrate) navigator.vibrate(ms);
        }

        window.oncontextmenu = (e) => { e.preventDefault(); return false; };

        // ==================== 1. САПЕР ====================
        let mSize = 8, mCount = 10, mData = [], mGameOver = false, mPressTimer = null;
        const M_COLORS = ['', '#0284c7', '#16a34a', '#dc2626', '#4f46e5', '#d97706', '#0d9488', '#9333ea', '#0f172a'];

        function initMines() {
            const diff = document.getElementById('mines-difficulty').value.split('-');
            mSize = parseInt(diff[0]); mCount = parseInt(diff[1]);
            const grid = document.getElementById('grid');
            grid.innerHTML = ''; mData = []; mGameOver = false;

            const cellPx = Math.min(36, Math.floor((window.innerWidth - 50) / mSize) - 4);
            grid.style.gridTemplateColumns = `repeat(${mSize}, ${cellPx}px)`;
            document.getElementById('m-count').innerText = mCount;

            let pool = Array(mSize * mSize).fill(0).map(() => ({ m: false, r: false, f: false, n: 0 }));
            for (let i = 0; i < mCount; i++) pool[i].m = true;
            pool.sort(() => Math.random() - 0.5);
            mData = pool;
            mData.forEach((d, i) => { if (!d.m) d.n = getNeighbors(i).filter(idx => mData[idx].m).length; });

            mData.forEach((d, i) => {
                const cell = document.createElement('div');
                cell.className = 'cell';
                cell.style.width = cellPx + 'px';
                cell.style.height = cellPx + 'px';

                cell.addEventListener('touchstart', (e) => {
                    e.preventDefault();
                    if (mGameOver) return;
                    mPressTimer = setTimeout(() => {
                        if (!d.r) {
                            d.f = !d.f; cell.innerHTML = d.f ? '🚩' : '';
                            const rect = cell.getBoundingClientRect();
                            spawnBurst(rect.left + rect.width / 2, rect.top + rect.height / 2, 12, ['#fbbf24', '#ef4444']);
                            doVibrate(50);
                        }
                        mPressTimer = null;
                    }, 450);
                }, { passive: false });

                cell.addEventListener('touchend', (e) => {
                    e.preventDefault();
                    if (mPressTimer) { clearTimeout(mPressTimer); mPressTimer = null; handleMinesMove(i); }
                }, { passive: false });

                cell.addEventListener('click', () => handleMinesMove(i));
                grid.appendChild(cell);
            });
        }

        function handleMinesMove(i) {
            const d = mData[i];
            if (!d || d.f || mGameOver) return;
            const cell = document.getElementById('grid').children[i];
            const rect = cell.getBoundingClientRect();
            const cx = rect.left + rect.width / 2, cy = rect.top + rect.height / 2;

            if (d.r) {
                let nb = getNeighbors(i);
                if (nb.filter(idx => mData[idx].f).length === d.n) {
                    nb.forEach(idx => { if (!mData[idx].f && !mData[idx].r) handleMinesMove(idx); });
                }
                return;
            }
            if (d.m) {
                mGameOver = true;
                mData.forEach((item, idx) => {
                    if (item.m) {
                        const c = document.getElementById('grid').children[idx];
                        c.classList.add('mine'); c.innerHTML = '💣';
                    }
                });
                spawnBurst(cx, cy, 40, ['#ef4444', '#f97316', '#fbbf24', '#ffffff']);
                spawnFloatText(cx, cy, '💥 БУМ!', '#ef4444');
                triggerShake(true); doVibrate(200);
                setTimeout(() => alert('БАБАХ! Игра окончена.'), 220);
            } else {
                revealMines(i);
                spawnBurst(cx, cy, 8, ['#38bdf8', '#ffffff']);
                doVibrate(20);
                if (mData.every(item => item.m || item.r)) {
                    mGameOver = true;
                    spawnBurst(window.innerWidth / 2, window.innerHeight / 2, 60);
                    spawnFloatText(window.innerWidth / 2, window.innerHeight / 2, '🏆 ПОБЕДА!', '#4ade80');
                    doVibrate([100, 50, 100]);
                    setTimeout(() => alert('ПОБЕДА! Все мины найдены!'), 250);
                }
            }
        }

        function revealMines(i) {
            if (mData[i].r || mData[i].f) return;
            mData[i].r = true;
            const cell = document.getElementById('grid').children[i];
            cell.classList.add('revealed');
            if (mData[i].n > 0) {
                cell.innerText = mData[i].n;
                cell.style.color = M_COLORS[mData[i].n];
            } else {
                getNeighbors(i).forEach(idx => revealMines(idx));
            }
        }

        function getNeighbors(idx) {
            const n = [], r = Math.floor(idx / mSize), c = idx % mSize;
            for (let y = -1; y <= 1; y++) for (let x = -1; x <= 1; x++) {
                let nr = r + y, nc = c + x;
                if (nr >= 0 && nr < mSize && nc >= 0 && nc < mSize && !(x === 0 && y === 0)) n.push(nr * mSize + nc);
            }
            return n;
        }

        // ==================== 2. ТЕТРИС ====================
        const tCanvas = document.getElementById('tetris-canvas');
        const tCtx = tCanvas.getContext('2d');
        let tBoard = [], tPiece = null, tScore = 0, tInt = null, tBusy = false;
        const T_COLORS = [null, '#38bdf8', '#fbbf24', '#a855f7', '#4ade80', '#ef4444', '#3b82f6', '#f97316'];
        const T_SHAPES = [null, [[1,1,1,1]], [[2,2],[2,2]], [[0,3,0],[3,3,3]], [[0,4,4],[4,4,0]], [[5,5,0],[0,5,5]], [[6,0,0],[6,6,6]], [[0,0,7],[7,7,7]]];

        function initTetris() {
            clearInterval(tInt); tBusy = false;
            tScore = 0; tBoard = Array.from({ length: 20 }, () => Array(10).fill(0));
            document.getElementById('tetris-score').innerText = '0';
            const speed = parseInt(document.getElementById('tetris-speed').value);
            spawnT(); drawT();
            tInt = setInterval(stepT, speed);
        }

        function spawnT() {
            const id = Math.floor(Math.random() * 7) + 1;
            tPiece = { s: T_SHAPES[id], x: 3, y: 0, c: id };
            if (collT()) {
                clearInterval(tInt); triggerShake(true); doVibrate([100, 50, 100]);
                setTimeout(() => { alert('ТЕТРИС: КОНЕЦ ИГРЫ! Счет: ' + tScore); initTetris(); }, 150);
            }
        }

        function collT() {
            return tPiece.s.some((row, dy) => row.some((v, dx) => {
                let nx = tPiece.x + dx, ny = tPiece.y + dy;
                return v && (nx < 0 || nx >= 10 || ny >= 20 || (ny >= 0 && tBoard[ny][nx]));
            }));
        }

        async function stepT() {
            if (tBusy || !tPiece) return;
            tPiece.y++;
            if (collT()) {
                tPiece.y--;
                tPiece.s.forEach((row, dy) => row.forEach((v, dx) => { if (v) tBoard[tPiece.y + dy][tPiece.x + dx] = tPiece.c; }));
                tBusy = true;
                await clearLinesT();
                tBusy = false;
                spawnT(); doVibrate(25);
            }
            drawT();
        }

        async function clearLinesT() {
            let fullRows = [];
            for (let y = 0; y < 20; y++) if (tBoard[y].every(v => v !== 0)) fullRows.push(y);
            if (fullRows.length > 0) {
                const rect = tCanvas.getBoundingClientRect();
                doVibrate(90); triggerShake(fullRows.length >= 2);
                fullRows.forEach(y => spawnBurst(rect.left + 100, rect.top + y * 20 + 10, 22));
                const pts = 100 * fullRows.length;
                spawnFloatText(rect.left + 100, rect.top + fullRows[0] * 20, fullRows.length > 1 ? `🔥 COMBO +${pts}!` : `+${pts}!`, '#4ade80');

                for (let i = 0; i < 3; i++) {
                    fullRows.forEach(y => { tCtx.fillStyle = 'white'; tCtx.fillRect(0, y * 20, 200, 20); });
                    await new Promise(r => setTimeout(r, 40));
                    drawT();
                    await new Promise(r => setTimeout(r, 40));
                }
                fullRows.forEach(y => { tBoard.splice(y, 1); tBoard.unshift(Array(10).fill(0)); });
                tScore += pts;
                document.getElementById('tetris-score').innerText = tScore;
            }
        }

        function drawT() {
            tCtx.fillStyle = '#1e293b'; tCtx.fillRect(0, 0, 200, 400);
            tBoard.forEach((row, y) => row.forEach((v, x) => { if (v) drawBlock(x, y, T_COLORS[v]); }));
            if (tPiece) tPiece.s.forEach((row, dy) => row.forEach((v, dx) => { if (v) drawBlock(tPiece.x + dx, tPiece.y + dy, T_COLORS[tPiece.c]); }));
        }

        function drawBlock(x, y, color) {
            tCtx.fillStyle = color; tCtx.fillRect(x * 20, y * 20, 19, 19);
            tCtx.fillStyle = 'rgba(255,255,255,0.28)'; tCtx.fillRect(x * 20, y * 20, 19, 4);
        }

        function moveLeftT() { if (tBusy) return; tPiece.x--; if (collT()) tPiece.x++; drawT(); doVibrate(10); }
        function moveRightT() { if (tBusy) return; tPiece.x++; if (collT()) tPiece.x--; drawT(); doVibrate(10); }
        function rotateT() {
            if (tBusy) return;
            let old = tPiece.s;
            tPiece.s = tPiece.s[0].map((_, i) => tPiece.s.map(r => r[i]).reverse());
            if (collT()) tPiece.s = old;
            drawT(); doVibrate(15);
        }
        function dropT() { stepT(); }

        // ==================== 3. МАДЖОНГ (15 УРОВНЕЙ + НАДЕЖНОЕ СОХРАНЕНИЕ ЗВЕЗД) ====================
        const MJ_SYMBOLS = [
            '🀄','🀅','🀆','🌸','🎋','🏮','🐉','🐯','🐢','🦊',
            '💎','👑','🔥','❄️','⚡','🍀','🌙','☀️','🍒','🍉'
        ];

        function getMahjongLayout(lvl) {
            const coords = [];
            const addRect = (x0, y0, w, h, z) => {
                for (let x = 0; x < w; x++)
                    for (let y = 0; y < h; y++)
                        coords.push({ x: x0 + x * 2, y: y0 + y * 2, z });
            };
            const addPt = (x, y, z) => coords.push({ x, y, z });

            switch (lvl) {
                case 1: addRect(0, 0, 4, 4, 0); addRect(2, 2, 2, 2, 1); break;
                case 2: addRect(0, 0, 6, 4, 0); addRect(2, 2, 4, 2, 1); addRect(4, 2, 2, 2, 2); break;
                case 3: addRect(0, 0, 2, 4, 0); addRect(8, 0, 2, 4, 0); addRect(2, 2, 3, 2, 0); addRect(2, 2, 3, 2, 1); addRect(0, 2, 1, 2, 1); addRect(10, 2, 1, 2, 1); break;
                case 4: addRect(4, 0, 2, 6, 0); addRect(0, 4, 2, 2, 0); addRect(8, 4, 2, 2, 0); addRect(4, 2, 2, 4, 1); addRect(4, 4, 2, 2, 2); break;
                case 5: addRect(0, 0, 3, 4, 0); addRect(8, 0, 3, 4, 0); addRect(1, 2, 2, 2, 1); addRect(9, 2, 2, 2, 1); addRect(2, 2, 1, 2, 2); addRect(10, 2, 1, 2, 2); break;
                case 6: addRect(0, 0, 6, 1, 0); addRect(0, 8, 6, 1, 0); addRect(0, 2, 1, 3, 0); addRect(10, 2, 1, 3, 0); addRect(0, 0, 6, 1, 1); addRect(0, 8, 6, 1, 1); addRect(4, 4, 2, 1, 0); addRect(4, 4, 2, 1, 1); addRect(0, 4, 1, 1, 1); addRect(10, 4, 1, 1, 1); break;
                case 7: addRect(4, 0, 2, 1, 0); addRect(2, 2, 4, 1, 0); addRect(0, 4, 6, 2, 0); addRect(2, 8, 4, 1, 0); addRect(4, 10, 2, 1, 0); addRect(2, 4, 4, 2, 1); addRect(4, 4, 2, 1, 2); break;
                case 8: addRect(0, 0, 6, 2, 0); addRect(0, 4, 6, 2, 0); addRect(2, 0, 4, 2, 1); addRect(4, 4, 2, 2, 1); break;
                case 9: addRect(0, 0, 2, 2, 0); addRect(8, 0, 2, 2, 0); addRect(0, 6, 2, 2, 0); addRect(8, 6, 2, 2, 0); addRect(4, 2, 2, 3, 0); addRect(4, 2, 2, 3, 1); addRect(0, 0, 2, 1, 1); addRect(8, 0, 2, 1, 1); addRect(0, 6, 2, 1, 1); addRect(8, 6, 2, 1, 1); addRect(4, 4, 2, 1, 2); addRect(2, 4, 1, 1, 0); addRect(8, 4, 1, 1, 0); break;
                case 10: addRect(0, 0, 6, 1, 0); addRect(2, 2, 4, 1, 0); addRect(4, 4, 2, 2, 0); addRect(2, 8, 4, 1, 0); addRect(0, 10, 6, 1, 0); addRect(2, 0, 4, 1, 1); addRect(2, 10, 4, 1, 1); addRect(4, 4, 2, 2, 1); break;
                case 11: addRect(0, 0, 6, 1, 0); addRect(10, 2, 1, 2, 0); addRect(0, 4, 5, 1, 0); addRect(0, 6, 1, 2, 0); addRect(0, 8, 6, 1, 0); addRect(2, 0, 4, 1, 1); addRect(2, 4, 3, 1, 1); addRect(2, 8, 4, 1, 1); addRect(4, 0, 2, 1, 2); addRect(4, 8, 2, 1, 2); addPt(6, 4, 2); addPt(8, 4, 1); break;
                case 12: addRect(0, 0, 6, 3, 0); addRect(2, 6, 4, 2, 0); addRect(4, 10, 2, 1, 0); addRect(2, 2, 4, 2, 1); addRect(4, 6, 2, 2, 1); addRect(4, 2, 2, 1, 2); break;
                case 13: addRect(0, 0, 6, 4, 0); addRect(1, 1, 5, 3, 1); addRect(3, 2, 3, 2, 2); addPt(5, 3, 3); break;
                case 14: addRect(0, 0, 6, 1, 0); addRect(0, 4, 6, 1, 0); addRect(0, 8, 6, 1, 0); addRect(0, 2, 2, 1, 0); addRect(8, 6, 2, 1, 0); addRect(0, 0, 6, 1, 1); addRect(0, 4, 6, 1, 1); addRect(0, 8, 6, 1, 1); addRect(4, 4, 2, 1, 2); addRect(4, 0, 2, 1, 2); break;
                case 15: addRect(0, 2, 6, 4, 0); addRect(2, 0, 4, 1, 0); addRect(2, 10, 4, 1, 0); addRect(2, 2, 4, 4, 1); addRect(4, 4, 2, 2, 2); addRect(4, 4, 2, 1, 3); break;
            }
            if (coords.length % 2 !== 0) coords.pop();
            return coords;
        }

        const LEVEL_NAMES = [
            'Старт', 'Пирамида', 'Мост', 'Крест', 'Башни',
            'Арена', 'Ромб', 'Лестница', 'Замок', 'Часы',
            'Змейка', 'Щит', 'Храм', 'Лабиринт', 'Дракон'
        ];

        let currentMjLevel = 1, mjTiles = [], selectedTileId = null, mjCombo = 0, mjHelpUsed = 0;
        let mjStars = loadMjStars();

        function loadMjStars() {
            try {
                const raw = localStorage.getItem('mjStars');
                if (raw) return JSON.parse(raw);
            } catch {}
            try {
                if (window.name && window.name.startsWith('MJ_STARS:')) {
                    return JSON.parse(window.name.slice(9));
                }
            } catch {}
            return {};
        }

        function saveMjStars(lvl, stars) {
            const prev = mjStars[lvl] || 0;
            if (stars > prev) mjStars[lvl] = stars;
            const data = JSON.stringify(mjStars);
            try { localStorage.setItem('mjStars', data); } catch {}
            try { window.name = 'MJ_STARS:' + data; } catch {}
        }

        function calcEarnedStars() {
            if (mjHelpUsed === 0) return 3;
            if (mjHelpUsed <= 2) return 2;
            return 1;
        }

        function openMahjongLevels() {
            showScreen('mahjong-levels-screen');
            const grid = document.getElementById('levels-grid');
            grid.innerHTML = '';

            const doneCount = Object.keys(mjStars).length;
            document.getElementById('mj-progress-text').innerText = `${doneCount} / 15`;
            document.getElementById('mj-progress-fill').style.width = `${(doneCount / 15) * 100}%`;

            for (let i = 1; i <= 15; i++) {
                const stars = mjStars[i] || 0;
                const isDone = stars > 0;
                const card = document.createElement('div');
                card.className = 'level-card' + (isDone ? ' done' : '');
                const starsHtml = isDone
                    ? '★'.repeat(stars) + `<span style="opacity:0.3">☆</span>`.repeat(3 - stars)
                    : '★★★';
                card.innerHTML = `
                    <div class="level-badge">✓ ПРОЙДЕНО</div>
                    <div class="level-num">${i}</div>
                    <div class="level-name">${LEVEL_NAMES[i - 1]}</div>
                    <div class="level-stars">${starsHtml}</div>
                `;
                card.onclick = () => startMahjongLevel(i);
                grid.appendChild(card);
            }
        }

        function isTileFree(tile, list) {
            const active = list.filter(t => !t.removed && t.id !== tile.id);
            const blockedAbove = active.some(t => t.z === tile.z + 1 && Math.abs(t.x - tile.x) < 2 && Math.abs(t.y - tile.y) < 2);
            if (blockedAbove) return false;
            const blockedLeft = active.some(t => t.z === tile.z && t.x === tile.x - 2 && Math.abs(t.y - tile.y) < 2);
            const blockedRight = active.some(t => t.z === tile.z && t.x === tile.x + 2 && Math.abs(t.y - tile.y) < 2);
            return !blockedLeft || !blockedRight;
        }

        function startMahjongLevel(lvl) {
            currentMjLevel = lvl; selectedTileId = null; mjCombo = 0; mjHelpUsed = 0;
            showScreen('mahjong-game-screen');
            document.getElementById('mj-level-title').innerText = `Уровень ${lvl}: ${LEVEL_NAMES[lvl - 1]}`;

            const layout = getMahjongLayout(lvl);
            mjTiles = layout.map((p, idx) => ({ id: idx, x: p.x, y: p.y, z: p.z, sym: '', removed: false }));

            let temp = mjTiles.map(t => ({ ...t }));
            const pairsCount = mjTiles.length / 2;
            const symPool = [];
            for (let i = 0; i < pairsCount; i++) symPool.push(MJ_SYMBOLS[i % MJ_SYMBOLS.length]);
            symPool.sort(() => Math.random() - 0.5);

            let symIdx = 0;
            while (temp.some(t => !t.removed)) {
                let free = temp.filter(t => !t.removed && isTileFree(t, temp));
                if (free.length < 2) free = temp.filter(t => !t.removed);
                free.sort(() => Math.random() - 0.5);
                const a = free[0], b = free[1], s = symPool[symIdx++];
                mjTiles[a.id].sym = s; mjTiles[b.id].sym = s;
                a.removed = true; b.removed = true;
            }
            renderMahjong();
        }

        function renderMahjong() {
            const stage = document.getElementById('mahjong-stage');
            stage.innerHTML = '';

            const remaining = mjTiles.filter(t => !t.removed);
            document.getElementById('mj-left').innerText = remaining.length;

            const maxX = Math.max(...mjTiles.map(t => t.x)) + 2;
            const maxY = Math.max(...mjTiles.map(t => t.y)) + 2;
            const availW = Math.min(window.innerWidth - 36, 400);
            const availH = window.innerHeight - 220;
            const unit = Math.min(Math.floor(availW / maxX), Math.floor(availH / maxY), 28);
            const tileW = unit * 2 - 2, tileH = unit * 2 - 2;

            stage.style.width = (maxX * unit + 16) + 'px';
            stage.style.height = (maxY * unit + 16) + 'px';

            remaining.sort((a, b) => a.z - b.z || a.y - b.y || a.x - b.x);
            remaining.forEach(t => {
                const free = isTileFree(t, mjTiles);
                const el = document.createElement('div');
                el.className = 'mj-tile' + (free ? '' : ' blocked') + (selectedTileId === t.id ? ' selected' : '');
                el.dataset.id = t.id;
                el.style.width = tileW + 'px'; el.style.height = tileH + 'px';
                el.style.left = (8 + t.x * unit - t.z * 4) + 'px';
                el.style.top = (8 + t.y * unit - t.z * 4) + 'px';
                el.style.zIndex = t.z * 100 + t.y;
                el.style.fontSize = Math.floor(tileW * 0.58) + 'px';
                el.innerText = t.sym;

                el.onclick = (e) => onMahjongTileClick(t, e);
                stage.appendChild(el);
            });
        }

        function onMahjongTileClick(tile, e) {
            if (!isTileFree(tile, mjTiles)) { doVibrate(15); return; }

            if (selectedTileId === tile.id) { selectedTileId = null; renderMahjong(); return; }
            if (selectedTileId === null) { selectedTileId = tile.id; doVibrate(15); renderMahjong(); return; }

            const first = mjTiles.find(t => t.id === selectedTileId);
            if (first && first.sym === tile.sym) {
                const firstEl = document.querySelector(`.mj-tile[data-id="${first.id}"]`);
                if (firstEl) {
                    const r1 = firstEl.getBoundingClientRect();
                    spawnBurst(r1.left + r1.width / 2, r1.top + r1.height / 2, 18, ['#fbbf24', '#38bdf8', '#f472b6']);
                }
                spawnBurst(e.clientX, e.clientY, 18, ['#fbbf24', '#4ade80', '#ffffff']);
                mjCombo++;
                const words = ['NICE!', 'BOOM!', 'COMBO x' + mjCombo + '!', '🔥 FIRE!'];
                spawnFloatText(e.clientX, e.clientY - 10, words[Math.min(mjCombo - 1, words.length - 1)], '#fbbf24');
                triggerShake(false);

                first.removed = true; tile.removed = true;
                selectedTileId = null;
                doVibrate(40);
                renderMahjong();
                checkMahjongState();
            } else {
                mjCombo = 0;
                selectedTileId = tile.id; doVibrate(15); renderMahjong();
            }
        }

        function findAvailablePair() {
            const free = mjTiles.filter(t => !t.removed && isTileFree(t, mjTiles));
            for (let i = 0; i < free.length; i++)
                for (let j = i + 1; j < free.length; j++)
                    if (free[i].sym === free[j].sym) return [free[i], free[j]];
            return null;
        }

        function showMahjongVictory(earnedStars) {
            const overlay = document.getElementById('mj-victory-overlay');
            const isLast = currentMjLevel >= 15;
            document.getElementById('victory-sub').innerText = `Уровень ${currentMjLevel}: ${LEVEL_NAMES[currentMjLevel - 1]}`;
            document.getElementById('victory-aura').innerText = isLast
                ? '👑 ВСЕ 15 УРОВНЕЙ ПРОЙДЕНЫ! +9999 AURA'
                : `🔥 +${currentMjLevel * earnedStars * 200} AURA • ${earnedStars}/3 ⭐`;

            const starEls = overlay.querySelectorAll('.v-star');
            starEls.forEach((el, idx) => {
                el.innerText = '⭐';
                el.classList.toggle('unearned', idx >= earnedStars);
            });

            document.getElementById('victory-next-btn').style.display = isLast ? 'none' : 'block';
            overlay.classList.add('active');

            triggerShake(true);
            doVibrate([80, 40, 80, 40, 180]);
            spawnConfettiCannon(true);
            spawnConfettiCannon(false);
            spawnBurst(window.innerWidth / 2, window.innerHeight / 2, 70, null, 1.4);

            const hypeWords = ['🔥 MEGA WIN!', '⚡ INSANE!', '💎 GG EZ!', '🎉 +1000 AURA!', '👑 LEGEND!', '🚀 HYPER!'];
            const hypeColors = ['#fbbf24', '#4ade80', '#38bdf8', '#f472b6', '#a855f7'];
            let wave = 0;

            clearInterval(victoryFxTimer);
            victoryFxTimer = setInterval(() => {
                wave++;
                const rx = 50 + Math.random() * (window.innerWidth - 100);
                const ry = 80 + Math.random() * (window.innerHeight * 0.55);
                spawnBurst(rx, ry, 28, null, 1.15);
                spawnFloatText(rx, ry, hypeWords[wave % hypeWords.length], hypeColors[wave % hypeColors.length]);
                if (wave % 2 === 0) {
                    spawnConfettiCannon(wave % 4 === 0);
                    triggerShake(false);
                }
            }, 550);
        }

        function goNextMahjongLevel() {
            clearInterval(victoryFxTimer);
            victoryFxTimer = null;
            document.getElementById('mj-victory-overlay').classList.remove('active');
            if (currentMjLevel < 15) startMahjongLevel(currentMjLevel + 1);
            else openMahjongLevels();
        }

        function closeVictoryAndOpenLevels() {
            clearInterval(victoryFxTimer);
            victoryFxTimer = null;
            document.getElementById('mj-victory-overlay').classList.remove('active');
            openMahjongLevels();
        }

        function checkMahjongState() {
            const left = mjTiles.filter(t => !t.removed);
            if (left.length === 0) {
                const earned = calcEarnedStars();
                saveMjStars(currentMjLevel, earned);
                showMahjongVictory(earned);
                return;
            }
            if (!findAvailablePair()) {
                setTimeout(() => { alert('Ходов больше нет! Перемешиваем фишки.'); mjShuffle(true); }, 200);
            }
        }

        function mjHint() {
            const pair = findAvailablePair();
            if (!pair) { mjShuffle(true); return; }
            mjHelpUsed++;
            document.querySelectorAll('.mj-tile').forEach(el => {
                const id = parseInt(el.dataset.id);
                if (id === pair[0].id || id === pair[1].id) el.classList.add('hint');
            });
            doVibrate(25);
        }

        function mjShuffle(isAuto = false) {
            if (!isAuto) mjHelpUsed++;
            const active = mjTiles.filter(t => !t.removed);
            const syms = active.map(t => t.sym).sort(() => Math.random() - 0.5);
            active.forEach((t, i) => t.sym = syms[i]);
            selectedTileId = null; mjCombo = 0;
            spawnBurst(window.innerWidth / 2, window.innerHeight / 2, 30);
            triggerShake(false); doVibrate(35);
            renderMahjong();
        }
    </script>
</body>
</html>
