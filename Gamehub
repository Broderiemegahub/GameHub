    <!-- ИГРА 3: МАДЖОНГ (ИГРА) -->
    <div id="mahjong-game-screen" class="screen">
        <div class="top-bar">
            <button class="btn btn-sm" onclick="openMahjongLevels()">⬅ Уровни</button>
            <div style="text-align:center;">
                <div id="mj-level-title" style="font-weight:bold; color:var(--gold); font-size:0.95rem;">Уровень 1</div>
                <div style="font-size:0.8rem; color:#cbd5e1;">Фишек: <span id="mj-left">0</span></div>
