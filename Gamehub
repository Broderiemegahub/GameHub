<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Game Hub: Hyper Neon</title>
    <style>
        :root {
            --bg: #0f172a;
            --accent: #38bdf8;
            --panel: rgba(30, 41, 59, 0.85);
            --gold: #fbbf24;
        }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; outline: none; }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: var(--bg);
            color: white;
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
            touch-action: manipulation;
            overflow: hidden;
            transition: background 0.4s ease;
        }

        /* Живой фон и слой частиц */
        #bg-canvas, #fx-canvas {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
        }
        #bg-canvas { z-index: 0; }
        #fx-canvas { z-index: 9999; }

        /* Тряска экрана */
        .shake-sm { animation: shakeSm 0.18s ease-out; }
        .shake-lg { animation: shakeLg 0.38s ease-out; }
        @keyframes shakeSm {
            0%, 100% { transform: translate(0, 0); }
            25% { transform: translate(-3px, 2px); }
            50% { transform: translate(3px, -2px); }
            75% { transform: translate(-2px, -1px); }
        }
        @keyframes shakeLg {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            20% { transform: translate(-9px, 7px) rotate(-1.8deg); }
            40% { transform: translate(9px, -7px) rotate(1.8deg); }
            60% { transform: translate(-6px, -4px) rotate(-1deg); }
            80% { transform: translate(5px, 4px) rotate(1deg); }
        }

        /* Переливающийся заголовок */
        .hub-title {
            font-size: 2.6rem;
            font-weight: 900;
            letter-spacing: 5px;
            margin: 0 0 12px 0;
            background: linear-gradient(90deg, var(--accent), #f472b6, var(--gold), var(--accent));
            background-size: 250% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: titleFlow 3s linear infinite, floatSlow 2.6s ease-in-out infinite;
            filter: drop-shadow(0 0 12px rgba(56, 189, 248, 0.35));
        }
        @keyframes titleFlow { to { background-position: 250% center; } }
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-6px); }
        }

        /* --- UI ЭЛЕМЕНТЫ --- */
        #main-menu {
            position: relative; z-index: 10;
            display: flex; flex-direction: column; gap: 13px;
            text-align: center; width: 270px;
            animation: screenPop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        @keyframes screenPop {
            from { opacity: 0; transform: scale(0.9) translateY(15px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .btn {
            position: relative; overflow: hidden;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(8px);
            border: 2px solid var(--accent);
            color: white; padding: 14px 22px;
            border-radius: 16px; font-size: 1.05rem; font-weight: 700;
            cursor: pointer;
            transition: transform 0.12s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s, box-shadow 0.2s;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25), 0 0 12px color-mix(in srgb, var(--accent) 30%, transparent);
        }
        .btn:active {
            transform: scale(0.91) rotate(-1deg);
            background: var(--accent);
            color: #0f172a;
        }
        #main-menu .btn::after {
            content: '';
            position: absolute; top: 0; left: -120%;
            width: 60%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.22), transparent);
            transform: skewX(-25deg);
            animation: btnShine 4s infinite;
        }
        #main-menu .btn:nth-child(3)::after { animation-delay: 0.6s; }
        #main-menu .btn:nth-child(4)::after { animation-delay: 1.2s; }
        #main-menu .btn:nth-child(5)::after { animation-delay: 1.8s; }
        @keyframes btnShine {
            0%, 75% { left: -120%; }
            100% { left: 160%; }
        }

        .btn-sm { padding: 9px 15px; font-size: 0.9rem; border-radius: 12px; }
        .btn-gold { border-color: var(--gold); color: var(--gold); }
        .btn-gold:active { background: var(--gold); color: #0f172a; }
        .btn-pink { border-color: #f472b6; color: #fbcfe8; }
        .btn-pink:active { background: #f472b6; color: #0f172a; }
        .btn-green { border-color: #4ade80; color: #0f172a; background: linear-gradient(135deg, #4ade80, #22c55e); }
        .btn-green:active { transform: scale(0.92); filter: brightness(1.15); }

        .screen {
            position: relative; z-index: 10;
            display: none; flex-direction: column; align-items: center;
            width: 100%; height: 100vh; padding: 16px; overflow-y: auto;
            animation: screenPop 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .top-bar {
            width: 100%; max-width: 420px; display: flex;
            justify-content: space-between; align-items: center; margin-bottom: 12px;
        }

        /* --- КАСТОМИЗАЦИЯ И НАСТРОЙКИ --- */
        .setting-block {
            background: var(--panel); backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.1);
            padding: 15px; border-radius: 16px; width: 310px;
            margin-bottom: 12px; text-align: left;
        }
        .setting-block h3 { margin: 0 0 8px 0; color: var(--accent); font-size: 0.95rem; }
        select {
            width: 100%; padding: 10px; border-radius: 10px;
            background: rgba(15, 23, 42, 0.85); color: white;
            border: 1px solid var(--accent); margin-top: 4px; font-size: 0.95rem;
        }
        .color-row { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; }
        input[type="color"] { width: 54px; height: 34px; border: none; border-radius: 8px; background: transparent; cursor: pointer; }
        .preset-row { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
        .preset-chip {
            flex: 1; min-width: 52px; height: 32px; border-radius: 10px;
            border: 2px solid rgba(255,255,255,0.3); cursor: pointer; transition: transform 0.15s;
        }
        .preset-chip:active { transform: scale(0.88); }

        /* --- САПЕР --- */
        #grid {
            display: grid; gap: 4px; background: rgba(51, 65, 85, 0.85);
            padding: 8px; border-radius: 12px;
            box-shadow: 0 0 25px rgba(0,0,0,0.5); touch-action: none;
        }
        .cell {
            background: #1e293b; border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; font-size: 1rem;
            transition: transform 0.12s, background 0.15s;
        }
        .cell:active { transform: scale(0.85); }
        .cell.revealed {
            background: #e2e8f0; color: #0f172a;
            animation: cellPop 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .cell.mine { background: #ef4444; box-shadow: 0 0 15px #ef4444; animation: cellPop 0.3s ease; }
        @keyframes cellPop { 0% { transform: scale(0.5); } 70% { transform: scale(1.12); } 100% { transform: scale(1); } }

        /* --- ТЕТРИС --- */
        #tetris-canvas {
            background: rgba(30, 41, 59, 0.9);
            border: 4px solid var(--accent); border-radius: 8px;
            box-shadow: 0 0 25px color-mix(in srgb, var(--accent) 35%, transparent);
        }
        .controls { display: grid; grid-template-columns: repeat(3, 66px); gap: 10px; margin-top: 12px; }
        .control-btn {
            width: 66px; height: 66px; background: rgba(255,255,255,0.08);
            backdrop-filter: blur(6px); border: 2px solid var(--accent); border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem; color: white; transition: transform 0.1s;
        }
        .control-btn:active { background: var(--accent); color: #0f172a; transform: scale(0.86); }

        /* --- МАДЖОНГ: ПРОГРЕСС И ПЛАШКИ УРОВНЕЙ --- */
        .mj-progress-wrap {
            width: 100%; max-width: 360px; margin-bottom: 12px;
            background: var(--panel); padding: 10px 14px; border-radius: 14px;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .mj-progress-header {
            display: flex; justify-content: space-between; font-size: 0.85rem;
            font-weight: 700; margin-bottom: 6px; color: #e2e8f0;
        }
        .mj-progress-bar {
            width: 100%; height: 10px; background: rgba(15, 23, 42, 0.85);
            border-radius: 99px; overflow: hidden;
        }
        .mj-progress-fill {
            height: 100%; width: 0%;
            background: linear-gradient(90deg, #4ade80, #38bdf8, #fbbf24);
            background-size: 200% 100%;
            border-radius: 99px;
            transition: width 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            animation: titleFlow 2.5s linear infinite;
        }

        .levels-grid {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 11px;
            width: 100%; max-width: 360px; margin: 4px 0 24px 0;
        }
        .level-card {
            position: relative; overflow: hidden;
            background: var(--panel); border: 2px solid rgba(255,255,255,0.14);
            border-radius: 16px; padding: 14px 6px 10px; text-align: center;
            cursor: pointer; transition: transform 0.15s, border-color 0.2s, box-shadow 0.2s;
            display: flex; flex-direction: column; align-items: center; gap: 3px;
        }
        .level-card:active { transform: scale(0.9) rotate(-2deg); border-color: var(--accent); }
        .level-num { font-size: 1.35rem; font-weight: 900; color: var(--accent); line-height: 1.1; }
        .level-name { font-size: 0.72rem; color: #cbd5e1; font-weight: 600; }
        .level-stars { font-size: 0.78rem; letter-spacing: 2px; color: rgba(255,255,255,0.16); margin-top: 2px; }

        /* Плашка пройденного уровня */
        .level-card.done {
            background: linear-gradient(145deg, rgba(16, 185, 129, 0.28), rgba(251, 191, 36, 0.16), rgba(15, 23, 42, 0.9));
            border: 2px solid #4ade80;
            box-shadow: 0 0 18px rgba(74, 222, 128, 0.35), inset 0 0 14px rgba(251, 191, 36, 0.15);
            padding-top: 20px;
        }
        .level-card.done::after {
            content: '';
            position: absolute; top: 0; left: -130%;
            width: 70%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.28), transparent);
            transform: skewX(-25deg);
            animation: btnShine 3.2s infinite;
        }
        .level-badge {
            display: none;
            position: absolute; top: 0; left: 0; right: 0;
            background: linear-gradient(90deg, #22c55e, #4ade80, #fbbf24);
            color: #052e16; font-size: 0.56rem; font-weight: 900;
            letter-spacing: 0.8px; padding: 2px 0; text-transform: uppercase;
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }
        .level-card.done .level-badge { display: block; }
        .level-card.done .level-num {
            background: linear-gradient(180deg, #ffffff, #4ade80);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 6px rgba(74, 222, 128, 0.5));
        }
        .level-card.done .level-name { color: #ecfdf5; }
        .level-card.done .level-stars {
            color: #fbbf24;
            text-shadow: 0 0 8px rgba(251, 191, 36, 0.85);
        }

        /* --- МАДЖОНГ: ПОЛЕ --- */
        #mahjong-stage {
            position: relative; margin: auto 0;
            background: rgba(15, 23, 42, 0.55); border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.12); touch-action: none;
        }
        .mj-tile {
            position: absolute; background: linear-gradient(145deg, #ffffff, #e2e8f0);
            border: 1px solid #94a3b8; border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            transition: transform 0.14s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.14s, filter 0.15s;
            box-shadow: 3px 4px 0 #64748b, 4px 6px 8px rgba(0,0,0,0.45);
        }
        .mj-tile.blocked { filter: brightness(0.72); }
        .mj-tile.selected {
            background: #e0f2fe; border: 2px solid var(--accent);
            box-shadow: 0 0 18px var(--accent), 3px 5px 0 #0369a1;
            transform: translateY(-5px) scale(1.08) rotate(-2deg);
            z-index: 999 !important;
        }
        .mj-tile.hint {
            border: 2px solid #fbbf24;
            box-shadow: 0 0 18px #fbbf24, 3px 4px 0 #b45309;
            animation: pulseHint 0.55s infinite alternate;
        }
        @keyframes pulseHint { from { transform: scale(1); } to { transform: scale(1.1) rotate(3deg); } }
        .mj-controls { display: flex; gap: 10px; margin-top: 12px; width: 100%; max-width: 360px; justify-content: center; }

        /* --- МЕГА СДВГ ЭКРАН ПОБЕДЫ В МАДЖОНГЕ --- */
        #mj-victory-overlay {
            display: none;
            position: fixed; inset: 0; z-index: 5000;
            background: rgba(9, 13, 28, 0.84);
            backdrop-filter: blur(8px);
            align-items: center; justify-content: center;
            overflow: hidden;
        }
        #mj-victory-overlay.active { display: flex; animation: fadeInFast 0.2s ease; }
        @keyframes fadeInFast { from { opacity: 0; } to { opacity: 1; } }

        .victory-rays {
            position: absolute;
            width: 170vmax; height: 170vmax;
            background: repeating-conic-gradient(
                from 0deg,
                rgba(251, 191, 36, 0.16) 0deg 15deg,
                transparent 15deg 30deg,
                rgba(56, 189, 248, 0.12) 30deg 45deg,
                transparent 45deg 60deg
            );
            animation: spinRays 10s linear infinite;
            pointer-events: none;
        }
        @keyframes spinRays { to { transform: rotate(360deg); } }

        .victory-card {
            position: relative; z-index: 2;
            width: 88%; max-width: 340px;
            background: linear-gradient(160deg, rgba(30, 41, 59, 0.96), rgba(15, 23, 42, 0.98));
            border-radius: 26px; padding: 26px 20px; text-align: center;
            border: 3px solid #fbbf24;
            box-shadow: 0 0 40px rgba(251, 191, 36, 0.5), 0 0 80px rgba(56, 189, 248, 0.35);
            animation: victorySlam 0.55s cubic-bezier(0.34, 1.56, 0.64, 1), rainbowBorder 2.2s linear infinite;
        }
        @keyframes victorySlam {
            0% { opacity: 0; transform: scale(0.25) rotate(-14deg); }
            60% { opacity: 1; transform: scale(1.08) rotate(3deg); }
            100% { transform: scale(1) rotate(0deg); }
        }
        @keyframes rainbowBorder {
            0%, 100% { border-color: #fbbf24; box-shadow: 0 0 38px rgba(251, 191, 36, 0.55); }
            33% { border-color: #4ade80; box-shadow: 0 0 38px rgba(74, 222, 128, 0.55); }
            66% { border-color: #f472b6; box-shadow: 0 0 38px rgba(244, 114, 182, 0.55); }
        }

        .victory-trophy {
            font-size: 4.2rem; line-height: 1;
            animation: trophyBounce 0.8s ease-in-out infinite alternate;
            filter: drop-shadow(0 0 18px rgba(251, 191, 36, 0.8));
        }
        @keyframes trophyBounce {
            from { transform: translateY(0) scale(1) rotate(-5deg); }
            to { transform: translateY(-10px) scale(1.12) rotate(5deg); }
        }

        .victory-title {
            font-size: 1.9rem; font-weight: 900; margin: 10px 0 4px;
            letter-spacing: 1.5px;
            background: linear-gradient(90deg, #fbbf24, #4ade80, #38bdf8, #f472b6, #fbbf24);
            background-size: 250% auto;
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            animation: titleFlow 1.6s linear infinite;
        }
        .victory-sub {
            font-size: 0.95rem; color: #cbd5e1; font-weight: 700; margin-bottom: 14px;
        }

        .victory-stars {
            display: flex; justify-content: center; gap: 10px;
            font-size: 2.4rem; margin-bottom: 16px;
        }
        .v-star {
            display: inline-block; opacity: 0;
            filter: drop-shadow(0 0 12px #fbbf24);
        }
        .v-star.unearned {
            filter: grayscale(1) brightness(0.45);
        }
        #mj-victory-overlay.active .v-star:nth-child(1) { animation: starPop 0.45s 0.15s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
        #mj-victory-overlay.active .v-star:nth-child(2) { animation: starPop 0.45s 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; font-size: 2.9rem; margin-top: -8px; }
        #mj-victory-overlay.active .v-star:nth-child(3) { animation: starPop 0.45s 0.49s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
        @keyframes starPop {
            0% { opacity: 0; transform: scale(0) rotate(-60deg); }
            75% { opacity: 1; transform: scale(1.3) rotate(12deg); }
            100% { opacity: 1; transform: scale(1) rotate(0deg); }
        }

        .victory-aura {
            display: inline-block;
            background: rgba(74, 222, 128, 0.18);
            border: 1px solid #4ade80; color: #86efac;
            padding: 5px 14px; border-radius: 99px;
            font-size: 0.8rem; font-weight: 800; margin-bottom: 18px;
            animation: pulseHint 0.7s infinite alternate;
        }

        .victory-actions {
            display: flex; flex-direction: column; gap: 10px;
        }
    </style>
</head>
<body>

    <canvas id="bg-canvas"></canvas>
    <canvas id="fx-canvas"></canvas>

    <!-- ГЛАВНОЕ МЕНЮ -->
    <div id="main-menu">
        <h1 class="hub-title">GAME HUB</h1>
        <button class="btn" onclick="showScreen('mines-screen'); initMines();">💣 САПЕР</button>
        <button class="btn" onclick="showScreen('tetris-screen'); initTetris();">🧱 ТЕТРИС</button>
        <button class="btn btn-gold" onclick="openMahjongLevels()">🀄 МАДЖОНГ</button>
        <button class="btn btn-pink" onclick="showScreen('lobby-screen')">🎨 КАСТОМИЗАЦИЯ ЛОББИ</button>
        <button class="btn" style="border-color: #94a3b8;" onclick="showScreen('settings-screen')">⚙️ НАСТРОЙКИ ИГР</button>
    </div>

    <!-- КАСТОМИЗАЦИЯ ЛОББИ -->
    <div id="lobby-screen" class="screen">
        <div class="top-bar">
            <button class="btn btn-sm" onclick="backToMenu()">⬅ Меню</button>
            <h3 style="margin:0; color:#f472b6;">🎨 ЛОББИ</h3>
            <div style="width:65px;"></div>
        </div>

        <div class="setting-block">
            <h3>Быстрые темы</h3>
            <div class="preset-row">
                <div class="preset-chip" style="background:linear-gradient(135deg,#0f172a,#38bdf8)" onclick="applyPreset('#0f172a','#38bdf8')" title="Кибер"></div>
                <div class="preset-chip" style="background:linear-gradient(135deg,#1e0b36,#d946ef)" onclick="applyPreset('#1e0b36','#d946ef')" title="Неон"></div>
                <div class="preset-chip" style="background:linear-gradient(135deg,#052e16,#4ade80)" onclick="applyPreset('#052e16','#4ade80')" title="Матрица"></div>
                <div class="preset-chip" style="background:linear-gradient(135deg,#2b0a0a,#fb7185)" onclick="applyPreset('#2b0a0a','#fb7185')" title="Огонь"></div>
                <div class="preset-chip" style="background:linear-gradient(135deg,#18181b,#fbbf24)" onclick="applyPreset('#18181b','#fbbf24')" title="Золото"></div>
            </div>
        </div>

        <div class="setting-block">
            <h3>Свои цвета</h3>
            <div class="color-row">
                <span>Цвет фона:</span>
                <input type="color" id="bg-picker" value="#0f172a" oninput="updateLobbyColors()">
            </div>
            <div class="color-row">
                <span>Цвет неона (акцент):</span>
                <input type="color" id="accent-picker" value="#38bdf8" oninput="updateLobbyColors()">
            </div>
        </div>

        <div class="setting-block">
            <h3>Живой фон лобби</h3>
            <select id="bg-effect-select" onchange="saveLobbyPrefs()">
                <option value="orbs">Неоновые шары (СДВГ-вайб)</option>
                <option value="stars">Гиперпространство (Звезды)</option>
                <option value="grid">Ретро-сетка</option>
                <option value="none">Выключен</option>
            </select>
        </div>

        <div class="setting-block">
            <h3>Уровень СДВГ-эффектов</h3>
            <select id="adhd-level" onchange="saveLobbyPrefs()">
                <option value="max">🔥 МАКСИМУМ (частицы + тряска)</option>
                <option value="mid">✨ Средний (только частицы)</option>
                <option value="off">😴 Спокойный (выкл)</option>
            </select>
        </div>

        <button class="btn btn-pink" onclick="backToMenu()">ГОТОВО</button>
    </div>

    <!-- НАСТРОЙКИ ИГР -->
    <div id="settings-screen" class="screen">
        <div class="top-bar">
            <button class="btn btn-sm" onclick="backToMenu()">⬅ Меню</button>
            <h3 style="margin:0; color:var(--accent);">⚙️ НАСТРОЙКИ</h3>
            <div style="width:65px;"></div>
        </div>
        <div class="setting-block">
            <h3>САПЕР</h3>
            <select id="mines-difficulty">
                <option value="8-10">Новичок (8x8, 10 мин)</option>
                <option value="10-16">Любитель (10x10, 16 мин)</option>
                <option value="12-25">Профи (12x12, 25 мин)</option>
            </select>
        </div>
        <div class="setting-block">
            <h3>ТЕТРИС</h3>
            <select id="tetris-speed">
                <option value="800">Медленно</option>
                <option value="500" selected>Нормально</option>
                <option value="250">Быстро</option>
            </select>
        </div>
        <div class="setting-block">
            <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
                <input type="checkbox" id="vibrate-on" checked style="width:20px; height:20px;"> Вибрация
            </label>
        </div>
        <button class="btn" onclick="backToMenu()">СОХРАНИТЬ</button>
